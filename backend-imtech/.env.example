# Copier ce fichier en .env et remplir les valeurs
PORT=3000
URL_BASE=http://localhost:3000/api
APP_NAME=IMTECH INFO

# Base MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_formation_db

# Obligatoire : le serveur refuse de démarrer sans. Générer une valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optionnel : origines autorisées par CORS (séparées par des virgules). Vide = toutes.
CORS_ORIGIN=

# Compte Gmail d'envoi (mot de passe d'application, pas le mot de passe du compte)
EMAIL_USER=
EMAIL_PASSWORD=

# Vitrine publique de l'application mobile (contacts d'IMTECH INFO)
IMTECH_FACEBOOK_URL=
IMTECH_EMAIL=
# WhatsApp au format international, sans espace ni « + » (ex. 261340000000)
IMTECH_WHATSAPP=
IMTECH_TELEPHONE=
IMTECH_ADRESSE=
IMTECH_SLOGAN=
IMTECH_DESCRIPTION=
